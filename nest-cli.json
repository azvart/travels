      }
    },
    "redis": {
      "type": "library",
      "root": "libs/redis",
      "entryFile": "index",
      "sourceRoot": "libs/redis/src",
      "compilerOptions": {
        "tsConfigPath": "libs/redis/tsconfig.lib.json"
      }
    },
    "routes": {
      "type": "application",
      "root": "apps/routes",
      "entryFile": "main",
      "sourceRoot": "apps/routes/src",
      "compilerOptions": {
        "tsConfigPath": "apps/routes/tsconfig.app.json"
      }
    },
    "user-processor": {
      "type": "application",
      "root": "apps/user-processor",
      "entryFile": "main",
      "sourceRoot": "apps/user-processor/src",
      "compilerOptions": {
        "tsConfigPath": "apps/user-processor/tsconfig.app.json"
      }
    }
  }
}