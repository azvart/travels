{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/gateway/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/gateway/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/gateway",
  "projects": {
    "accounts": {
      "type": "application",
      "root": "apps/accounts",
      "entryFile": "main",
      "sourceRoot": "apps/accounts/src",
      "compilerOptions": {
        "tsConfigPath": "apps/accounts/tsconfig.app.json"
      }
    },
    "app-config": {
      "type": "library",
      "root": "libs/app-config",
      "entryFile": "index",
      "sourceRoot": "libs/app-config/src",
      "compilerOptions": {
        "tsConfigPath": "libs/app-config/tsconfig.lib.json"
      }
    },
    "auth": {
      "type": "library",
      "root": "libs/auth",
      "entryFile": "index",
      "sourceRoot": "libs/auth/src",
      "compilerOptions": {
        "tsConfigPath": "libs/auth/tsconfig.lib.json"
      }
    },
    "awards": {
      "type": "application",
      "root": "apps/awards",
      "entryFile": "main",
      "sourceRoot": "apps/awards/src",
      "compilerOptions": {
        "tsConfigPath": "apps/awards/tsconfig.app.json"
      }
    },
    "entities": {
      "type": "library",
      "root": "libs/entities",
      "entryFile": "index",
      "sourceRoot": "libs/entities/src",
      "compilerOptions": {
        "tsConfigPath": "libs/entities/tsconfig.lib.json"
      }
    },
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/gateway/tsconfig.app.json"
      }
    },
    "grpc-api-clients": {
      "type": "library",
      "root": "libs/grpc-api-clients",
      "entryFile": "index",
      "sourceRoot": "libs/grpc-api-clients/src",
      "compilerOptions": {
        "tsConfigPath": "libs/grpc-api-clients/tsconfig.lib.json"
      }
    },
    "interfaces": {
      "type": "library",
      "root": "libs/interfaces",
      "entryFile": "index",
      "sourceRoot": "libs/interfaces/src",
      "compilerOptions": {
        "tsConfigPath": "libs/interfaces/tsconfig.lib.json"
      }
    },
    "jobs-processor": {
      "type": "application",
      "root": "apps/jobs-processor",
      "entryFile": "main",
      "sourceRoot": "apps/jobs-processor/src",
      "compilerOptions": {
        "tsConfigPath": "apps/jobs-processor/tsconfig.app.json"
      }
    },
    "proto": {
      "type": "library",
      "root": "libs/proto",
      "entryFile": "index",
      "sourceRoot": "libs/proto/src",
      "compilerOptions": {
        "tsConfigPath": "libs/proto/tsconfig.lib.json"
      }
    },
    "pubsub": {
      "type": "library",
      "root": "libs/pubsub",
      "entryFile": "index",
      "sourceRoot": "libs/pubsub/src",
      "compilerOptions": {
        "tsConfigPath": "libs/pubsub/tsconfig.lib.json"
      }
    },
    "quest": {
      "type": "application",
      "root": "apps/quest",
      "entryFile": "main",
      "sourceRoot": "apps/quest/src",
      "compilerOptions": {
        "tsConfigPath": "apps/quest/tsconfig.app.json"
      }
    },
    "quest-processor": {
      "type": "application",
      "root": "apps/quest-processor",
      "entryFile": "main",
      "sourceRoot": "apps/quest-processor/src",
